model Model
	culture: sv-SE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: sv-SE
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_customer_scd2","employees","projects","project_costs","invoices","timesheets"]

annotation PBI_ProTooling = ["DevMode"]

ref table projects
ref table project_costs
ref table invoices
ref table dim_customer_scd2
ref table dim_date
ref table employees
ref table timesheets
ref table _Mått

ref cultureInfo sv-SE

