table _Mått
	lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f70

	measure Fakturerat = SUM(invoices[amount])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f71

	measure 'Antal fakturor' = DISTINCTCOUNT(invoices[invoice_id])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f72

	measure Snittfaktura = DIVIDE([Fakturerat], [Antal fakturor])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f73

	measure Kostnad = SUM(project_costs[amount])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f74

	measure Budget = SUM(projects[budget_amount])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f75

	measure Marginal = [Fakturerat] - [Kostnad]
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f76

	measure 'Budgetavvikelse %' = DIVIDE([Kostnad] - [Budget], [Budget])
		formatString: 0.0%
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f77

	measure 'Antal projekt' = DISTINCTCOUNT(projects[project_id])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f78

	measure Timmar = SUM(timesheets[hours])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f80

	measure Personalkostnad = SUMX(timesheets, timesheets[hours] * RELATED(employees[hourly_cost]))
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f81

	measure 'Fakturerbart värde' = SUMX(timesheets, timesheets[hours] * RELATED(employees[hourly_rate]))
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f82

	measure 'Fakturerbara timmar' = CALCULATE(SUM(timesheets[hours]), timesheets[is_billable] = TRUE())
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f83

	measure Beläggningsgrad = DIVIDE([Fakturerbara timmar], [Timmar])
		formatString: 0.0%
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f84

	measure 'Antal anställda' = DISTINCTCOUNT(timesheets[employee_id])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f85

	measure 'Total kostnad' = [Kostnad] + [Personalkostnad]
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f86

	measure 'Total marginal' = [Fakturerat] - [Total kostnad]
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f87

	measure 'Fakturerat (endast aktuell kundversion)' = CALCULATE([Fakturerat], dim_customer_scd2[is_current] = TRUE())
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f88

	measure 'Antal kostnadsrader' = COUNTROWS(project_costs)
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f89

	measure 'Antal unika kostnads-id' = DISTINCTCOUNT(project_costs[cost_id])
		formatString: #,0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f8a

	measure materialkostnad = CALCULATE([Kostnad],KEEPFILTERS(project_costs[cost_type]="material"))
		lineageTag: 0d205b32-cd8a-488f-aa9b-e4615c73f7f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Maskinhyra = CALCULATE([Kostnad],KEEPFILTERS(project_costs[cost_type]="Maskinhyra"))
		lineageTag: 7d709c1f-5e83-4582-ab6b-2e499f6c3a66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UE = CALCULATE([Kostnad],KEEPFILTERS(project_costs[cost_type]="Underentreprenör"))
		lineageTag: 232e22bb-6bfe-45f5-a7e5-4535f3591544

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Övrigt = ```
			CALCULATE([Kostnad],KEEPFILTERS(project_costs[cost_type]="övrigt")) 
			```
		lineageTag: 0451dbe1-aae6-42b1-9e4b-5c9a4ebec147

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Procent = DIVIDE([Kostnad],CALCULATE([Kostnad], ALL(project_costs[cost_type] )))
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: a1a487f3-b1d9-41a7-8290-28515e3b08b2

	measure 'cost mot budget' = DIVIDE([Total Kostnad],[Budget])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b51e3b48-a7fa-490e-94d6-0d0b9b72453a

	measure 'personal mot budget' = DIVIDE([Personalkostnad],[Budget])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 94ada3f9-104d-4fed-aab4-37a3c0c2a18a

	measure 'kvar av budget' = ([Budget]-[Total kostnad])
		lineageTag: b010c156-63d1-41b0-bfd9-faf6457f329b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7b2e0c22-1e32-4b82-8a10-2b3c4d5e6f79
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Mått = calculated
		mode: import
		source = {BLANK()}

	annotation PBI_ResultType = Table

