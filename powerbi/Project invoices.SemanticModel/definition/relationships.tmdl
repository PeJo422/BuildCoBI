relationship rel_invoice_project
	fromColumn: invoices.project_id
	toColumn: projects.project_id

relationship rel_invoice_date
	fromColumn: invoices.invoice_date
	toColumn: dim_date.Date

relationship rel_invoice_customer_sk
	fromColumn: invoices.customer_sk
	toColumn: dim_customer_scd2.customer_sk

relationship rel_cost_project
	fromColumn: project_costs.project_id
	toColumn: projects.project_id

relationship rel_cost_date
	fromColumn: project_costs.cost_date
	toColumn: dim_date.Date

relationship rel_cost_customer_sk
	fromColumn: project_costs.customer_sk
	toColumn: dim_customer_scd2.customer_sk

relationship rel_timesheet_project
	fromColumn: timesheets.project_id
	toColumn: projects.project_id

relationship rel_timesheet_date
	fromColumn: timesheets.work_date
	toColumn: dim_date.Date

relationship rel_timesheet_customer_sk
	fromColumn: timesheets.customer_sk
	toColumn: dim_customer_scd2.customer_sk

relationship rel_timesheet_employee
	fromColumn: timesheets.employee_id
	toColumn: employees.employee_id

